{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "heimdall",
    "namespace": "global",
    "description": "Bootstrap integration type for the Heimdall ecosystem guardian plugin.",
    "labels": {
      "bootstrap_source": "integration-heimdall",
      "provider": "heimdall",
      "yggdrasil.io/catalog-domain": "heimdall",
      "yggdrasil.io/catalog-section": "operations",
      "yggdrasil.io/catalog-entry": "guardian"
    }
  },
  "spec": {
    "provider": "heimdall",
    "adapter": {
      "transport": "rabbitmq",
      "version": "1.0.0",
      "queues": {
        "describe": "yggdrasil.adapter.heimdall.describe",
        "execute": "yggdrasil.adapter.heimdall.execute"
      },
      "timeout_seconds": 45
    },
    "capabilities": [
      "describe",
      "execute"
    ],
    "credential_schema": {
      "mode": "none"
    },
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "guardian_name": {
          "type": "string",
          "description": "Display name used by the ecosystem guardian.",
          "default": "Heimdall"
        },
        "observation_scope": {
          "type": "string",
          "description": "Logical scope observed by the guardian.",
          "default": "global"
        },
        "critical_auto_remediation_enabled": {
          "type": "boolean",
          "description": "Whether Heimdall should prepare auto-dispatchable remediation plans for critical incidents.",
          "default": false
        },
        "recommendation_limit": {
          "type": "integer",
          "description": "Maximum number of recommendations returned per execution.",
          "default": 10
        },
        "default_owner_team": {
          "type": "string",
          "description": "Default team escalated in remediation recommendations.",
          "default": "team:platform"
        },
        "default_repository_owner": {
          "type": "string",
          "description": "Default GitHub owner used when Heimdall synthesizes deploy workflow dispatches.",
          "default": "dakasa-yggdrasil"
        },
        "default_deploy_workflow": {
          "type": "string",
          "description": "Workflow filename used when Heimdall suggests a redeploy action.",
          "default": "deploy.yml"
        },
        "queue_backlog_threshold": {
          "type": "integer",
          "description": "Backlog threshold that turns a queue signal into an actionable finding.",
          "default": 1000
        },
        "error_rate_threshold": {
          "type": "number",
          "description": "Error-rate threshold that marks a component as unhealthy.",
          "default": 0.2
        },
        "secret_expiry_warning_hours": {
          "type": "integer",
          "description": "Warn when managed secrets expire within this many hours.",
          "default": 72
        }
      }
    },
    "resource_types": [
      {
        "name": "ecosystem_snapshot",
        "canonical_prefix": "thirdparty.heimdall.ecosystem_snapshot",
        "identity_template": "ecosystem_snapshot.{scope}",
        "discoverable": false,
        "default_actions": [
          "assess_ecosystem",
          "recommend_improvements"
        ]
      },
      {
        "name": "critical_incident",
        "canonical_prefix": "thirdparty.heimdall.critical_incident",
        "identity_template": "critical_incident.{component_kind}.{component_name}.{category}",
        "discoverable": false,
        "default_actions": [
          "triage_critical_error",
          "auto_remediate_critical"
        ]
      },
      {
        "name": "remediation_plan",
        "canonical_prefix": "thirdparty.heimdall.remediation_plan",
        "identity_template": "remediation_plan.{component_kind}.{component_name}.{severity}",
        "discoverable": false,
        "default_actions": [
          "auto_remediate_critical"
        ]
      },
      {
        "name": "ecosystem_recommendation",
        "canonical_prefix": "thirdparty.heimdall.recommendation",
        "identity_template": "ecosystem_recommendation.{scope}.{title}",
        "discoverable": false,
        "default_actions": [
          "recommend_improvements"
        ]
      }
    ],
    "action_catalog": [
      {
        "name": "assess_ecosystem",
        "description": "Observe the ecosystem snapshot and return health findings with an overall health score.",
        "resource_types": [
          "ecosystem_snapshot"
        ],
        "idempotent": true
      },
      {
        "name": "recommend_improvements",
        "description": "Produce prioritized improvement recommendations from the observed ecosystem state.",
        "resource_types": [
          "ecosystem_snapshot",
          "ecosystem_recommendation"
        ],
        "idempotent": true
      },
      {
        "name": "triage_critical_error",
        "description": "Triage one critical ecosystem incident into a diagnosis and immediate response actions.",
        "resource_types": [
          "critical_incident"
        ],
        "idempotent": true
      },
      {
        "name": "auto_remediate_critical",
        "description": "Prepare a machine-actionable remediation plan for one critical ecosystem incident.",
        "resource_types": [
          "critical_incident",
          "remediation_plan"
        ],
        "idempotent": true
      }
    ],
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "normalization": {
      "external_id_path": "id",
      "name_path": "title",
      "owner_path": "component_name",
      "fallback_resource_prefix": "thirdparty.heimdall.custom"
    },
    "execution": {
      "supports_dry_run": true,
      "idempotent_actions": [
        "assess_ecosystem",
        "recommend_improvements",
        "triage_critical_error",
        "auto_remediate_critical"
      ]
    },
    "extensions": {
      "preserve_raw_payload": true
    }
  }
}
