# Generated by `yggdrasil init` at {{ .GeneratedAt }}
# Store this file with your other secrets: it holds database
# credentials, the bootstrap admin password, and (optionally) any
# rpc.Transport backend URLs the container stack needs to restart
# consistently.

# ─── Container image pin ───────────────────────────────────────────────
YGGDRASIL_CORE_IMAGE={{ .CoreImage }}

# ─── Runtime posture (local development) ───────────────────────────────
# This stack is a local development environment. yggdrasil-core allows
# credential-free workflow dispatch, event publishes, deploy, bootstrap
# and integration install only while no matching credential is
# configured and YGGDRASIL_ENV names a development environment (dev,
# development, local or test). Since yggdrasil-core ADR-0022 an unset
# value no longer counts as development, so keep this line on a
# machine only you can reach. On a host other people can reach, set it
# to anything else (for example "staging") to close those calls, and
# set YGGDRASIL_DEPLOY_TOKEN below to keep using the deploy routes. `production` turns on Core's boot
# gate, which needs secrets this stack does not generate.
YGGDRASIL_ENV=development

# Dedicated bearer for the deploy, bootstrap and integration-install
# routes (clients send it as `Authorization: Bearer` or
# `X-Deploy-Token`). Left commented, they accept calls with no
# credential only while YGGDRASIL_ENV is a development value (on a
# Core older than ADR-0022, for every value except production and
# prod).
# YGGDRASIL_DEPLOY_TOKEN=

# ─── Listener ──────────────────────────────────────────────────────────
CORE_HTTP_PORT={{ .HTTPPort }}

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER={{ .PostgresUser }}
POSTGRES_PASSWORD={{ .PostgresPassword }}
POSTGRES_DB={{ .PostgresDB }}

# ─── Opt-in AMQP rpc.Transport (RabbitMQ) ─────────────────────────────
# The core boots HTTP-only by default. To enable the AMQP backend:
#   1. Uncomment BROKER_URL below (and the RABBITMQ_* credentials).
#   2. Run with the `amqp` compose profile:
#        docker compose --profile amqp up -d
# Leave commented for pure-HTTP deployments.
# RABBITMQ_USER={{ .RabbitMQUser }}
# RABBITMQ_PASSWORD={{ .RabbitMQPassword }}
# BROKER_URL=amqp://{{ .RabbitMQUser }}:{{ .RabbitMQPassword }}@rabbitmq:5672/

# ─── Session cookie (safe defaults for localhost) ──────────────────────
AUTH_SESSION_TTL_HOURS=720
AUTH_SESSION_COOKIE_NAME=yggdrasil_session

# ─── First-run bootstrap (fires once on empty DB) ──────────────────────
# Delete these after the first successful boot if you prefer to manage
# the admin credential through `yggdrasil login` from then on.
YGGDRASIL_BOOTSTRAP_ADMIN_USERNAME={{ .AdminUsername }}
YGGDRASIL_BOOTSTRAP_ADMIN_PASSWORD={{ .AdminPassword }}
YGGDRASIL_BOOTSTRAP_ADMIN_EMAIL={{ .AdminEmail }}
YGGDRASIL_BOOTSTRAP_ADMIN_DISPLAY_NAME={{ .AdminDisplayName }}
